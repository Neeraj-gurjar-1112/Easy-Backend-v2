{
  "name": "easy-backend",
  "version": "2.0.0",
  "description": "Easy App backend - app API, admin API and realtime socket services sharing one lib",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "start:all": "node server.js",
    "start:app": "node src/app/index.js",
    "start:admin": "node src/admin/index.js",
    "start:socket": "node src/socket/index.js",
    "dev": "nodemon server.js",
    "dev:app": "nodemon src/app/index.js",
    "dev:admin": "nodemon src/admin/index.js",
    "dev:socket": "nodemon src/socket/index.js",
    "dev:split": "concurrently -n app,admin,socket -c blue,magenta,green \"npm:dev:app\" \"npm:dev:admin\" \"npm:dev:socket\"",
    "seed": "node scripts/seed.js",
    "backfill-locations": "node scripts/backfill_locations.js",
    "map-admin-uid": "node scripts/map_admin_uid.js",
    "map-seller-uid": "node scripts/map_seller_uid.js",
    "backfill-discounts": "node scripts/backfill_discounts.js",
    "test-nearest-agent": "node scripts/test_nearest_agent.js",
    "monitor-assignments": "node scripts/monitor_assignment_patterns.js",
    "test-capacity": "node scripts/test_capacity_availability.js",
    "test": "jest --coverage --verbose",
    "test:serial": "jest --runInBand --coverage --verbose",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/ --testPathIgnorePatterns=integration",
    "test:integration": "jest tests/ --testPathPattern=integration"
  },
  "_moduleAliases": {
    "@root": ".",
    "@lib": "lib",
    "@models": "lib/models",
    "@util": "lib/util",
    "@middleware": "lib/middleware",
    "@events": "lib/events",
    "@push": "lib/push",
    "@sms": "lib/sms",
    "@app": "src/app",
    "@admin": "src/admin",
    "@socket": "src/socket"
  },
  "license": "ISC",
  "dependencies": {
    "@google-cloud/storage": "^7.11.0",
    "@sentry/node": "^10.23.0",
    "@sentry/profiling-node": "^10.23.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.3.0",
    "firebase-admin": "^12.6.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "mongodb": "^6.19.0",
    "mongoose": "^8.18.1",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "redis": "^4.6.13",
    "sharp": "^0.33.0",
    "socket.io": "^4.8.1",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.3.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.1.0"
  }
}
